msgid "Line review is disabled in settings"
msgstr "Просмотр строк отключен в настройках"

#: cmdCore.py:571
msgid "Line review off"
msgstr "Просмотр строк выключен"

#: cmdCore.py:577
msgid "Line review on"
msgstr "Просмотр строк включен"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "Файл журнала не найден"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "Ведение журнала отключено в строгом режиме конфиденциальности"

#: cmdCore.py:493
msgid "No history available"
msgstr "История недоступна"

#: cmdCore.py:488
msgid "Not in Command Prompt"
msgstr "Не в командной строке"

#: cmdCore.py:603
msgid "Opening CMDReader log"
msgstr "Открытие журнала CMDReader"

#: cmdCore.py:87
msgid "Play indicator sounds (Ready, Finished, Error)"
msgstr "Воспроизводить звуковые индикаторы (Готово, Завершено, Ошибка)"

#: cmdCore.py:536
msgid "Single tap: toggle line review (Up and Down arrows read the console output one line at a time). Double tap: open the CMDReader log file. Triple tap: open CMDReader settings"
msgstr "Одиночное нажатие: переключить просмотр строк (стрелки «Вверх» и «Вниз» читают вывод консоли по одной строке). Двойное нажатие: открыть лог-файл CMDReader. Тройное нажатие: открыть настройки CMDReader"

#: cmdCore.py:97
msgid "Start line review automatically when a console window gets focus"
msgstr "Автоматически запускать просмотр строк при получении фокуса консольным окном"

#: cmdCore.py:82
msgid "Strict Privacy Mode (Disable writing logs to disk)"
msgstr "Строгий режим конфиденциальности (Отключить запись журналов на диск)"

#: cmdCore.py:499
msgid "Top"
msgstr "Вверх"
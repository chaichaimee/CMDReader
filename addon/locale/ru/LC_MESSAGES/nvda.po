msgid "Command Finished"
msgstr "Команда выполнена"

#: cmdCore.py:613
msgid "Could not open CMDReader log"
msgstr "Не удалось открыть лог-файл CMDReader"

#: cmdCore.py:102
msgid "Error keywords (comma separated):"
msgstr "Ключевые слова ошибок (через запятую):"


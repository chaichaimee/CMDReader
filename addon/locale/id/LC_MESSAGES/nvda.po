#: cmdCore.py:92
msgid "Allow line review with the Up and Down arrow keys (single tap of Control+Alt+L toggles it)"
msgstr "Izinkan peninjauan baris dengan tombol panah Atas dan Bawah (ketukan tunggal Control+Alt+L untuk beralih)"

#: cmdCore.py:502
msgid "Bottom"
msgstr "Bawah"


msgid "Command Finished"
msgstr "Perintah Selesai"

#: cmdCore.py:613
msgid "Could not open CMDReader log"
msgstr "Tidak dapat membuka log CMDReader"

#: cmdCore.py:102
msgid "Error keywords (comma separated):"
msgstr "Kata kunci kesalahan (dipisahkan koma):"

#: cmdCore.py:567
msgid "Line review is disabled in settings"
msgstr "Peninjauan baris dinonaktifkan di pengaturan"

#: cmdCore.py:571
msgid "Line review off"
msgstr "Peninjauan baris nonaktif"

#: cmdCore.py:577
msgid "Line review on"
msgstr "Peninjauan baris aktif"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "Berkas log tidak ditemukan"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "Pencatatan log dinonaktifkan dalam Mode Privasi Ketat"

#: cmdCore.py:493
msgid "No history available"
msgstr "Tidak ada riwayat tersedia"

#: cmdCore.py:488
msgid "Not in Command Prompt"
msgstr "Tidak berada di Command Prompt"

#: cmdCore.py:603
msgid "Opening CMDReader log"
msgstr "Membuka log CMDReader"

#: cmdCore.py:87
msgid "Play indicator sounds (Ready, Finished, Error)"
msgstr "Putar suara indikator (Siap, Selesai, Kesalahan)"

#: cmdCore.py:536
msgid "Single tap: toggle line review (Up and Down arrows read the console output one line at a time). Double tap: open the CMDReader log file. Triple tap: open CMDReader settings"
msgstr "Ketukan tunggal: beralih peninjauan baris (panah Atas dan Bawah membaca keluaran konsol satu baris pada satu waktu). Ketukan ganda: buka file log CMDReader. Ketukan tiga kali: buka pengaturan CMDReader"

#: cmdCore.py:97
msgid "Start line review automatically when a console window gets focus"
msgstr "Mulai peninjauan baris secara otomatis saat jendela konsol mendapatkan fokus"

#: cmdCore.py:82
msgid "Strict Privacy Mode (Disable writing logs to disk)"
msgstr "Mode Privasi Ketat (Nonaktifkan penulisan log ke disk)"


#: cmdCore.py:92
msgid "Allow line review with the Up and Down arrow keys (single tap of Control+Alt+L toggles it)"
msgstr "ऊपर और नीचे तीर कुंजियों के साथ लाइन समीक्षा की अनुमति दें (कंट्रोल+ऑल्ट+एल का एक बार टैप इसे टॉगल करता है)"

#: cmdCore.py:502
msgid "Bottom"
msgstr "सबसे नीचे"

#: cmdCore.py:76
#: cmdCore.py:116
msgid "CMDReader"
msgstr "सीएमडीरीडर"

#: cmdCore.py:441
msgid "Command Finished"
msgstr "कमांड समाप्त"

#: cmdCore.py:613
msgid "Could not open CMDReader log"
msgstr "सीएमडीरीडर लॉग नहीं खोला जा सका"

#: cmdCore.py:102
msgid "Error keywords (comma separated):"
msgstr "त्रुटी कीवर्ड (कोमा द्वारा अलग किए गए):"

#: cmdCore.py:567
msgid "Line review is disabled in settings"
msgstr "सेटिंग्स में लाइन समीक्षा अक्षम है"

#: cmdCore.py:571
msgid "Line review off"
msgstr "लाइन समीक्षा बंद"

#: cmdCore.py:577
msgid "Line review on"
msgstr "लाइन समीक्षा चालू"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "लॉग फ़ाइल नहीं मिली"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "सख्त गोपनीयता मोड में लॉगिंग अक्षम है"

#: cmdCore.py:493
msgid "No history available"
msgstr "कोई इतिहास उपलब्ध नहीं है"

#: cmdCore.py:488
msgid "Not in Command Prompt"
msgstr "कमांड प्रॉम्प्ट में नहीं हैं"

#: cmdCore.py:603
msgid "Opening CMDReader log"
msgstr "CMDReader लॉग खोला जा रहा है"

#: cmdCore.py:87
msgid "Play indicator sounds (Ready, Finished, Error)"
msgstr "संकेतक ध्वनियाँ चलाएं (तैयार, समाप्त, त्रुटि)"

#: cmdCore.py:536
msgid "Single tap: toggle line review (Up and Down arrows read the console output one line at a time). Double tap: open the CMDReader log file. Triple tap: open CMDReader settings"
msgstr "एकल टैप: लाइन समीक्षा टॉगल करें (ऊपर और नीचे तीर कुंजियाँ कंसोल आउटपुट को एक समय में एक लाइन पढ़ती हैं)। डबल टैप: सीएमडीरीडर लॉग फ़ाइल खोलें। ट्रिपल टैप: सीएमडीरीडर सेटिंग्स खोलें"

#: cmdCore.py:97
msgid "Start line review automatically when a console window gets focus"
msgstr "जब किसी कंसोल विंडो को फोकस मिले तो स्वचालित रूप से लाइन समीक्षा शुरू करें"

#: cmdCore.py:82
msgid "Strict Privacy Mode (Disable writing logs to disk)"
msgstr "सख्त गोपनीयता मोड (डिस्क पर लॉग लिखना अक्षम करें)"

#: cmdCore.py:499
msgid "Top"
msgstr "सबसे ऊपर"
msgid "Error keywords (comma separated):"
msgstr "Palabras clave de error (separadas por comas):"

#: cmdCore.py:567
msgid "Line review is disabled in settings"
msgstr "La revisión de líneas está desactivada en la configuración"

#: cmdCore.py:571
msgid "Line review off"
msgstr "Revisión de líneas desactivada"

#: cmdCore.py:577
msgid "Line review on"
msgstr "Revisión de líneas activada"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "Archivo de registro no encontrado"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "El registro está desactivado en el modo de privacidad estricta"

#: cmdCore.py:493
msgid "No history available"
msgstr "No hay historial disponible"

#: cmdCore.py:488
msgid "Not in Command Prompt"
msgstr "No se encuentra en el Símbolo del sistema"

#: cmdCore.py:603
msgid "Opening CMDReader log"
msgstr "Abriendo registro de CMDReader"

#: cmdCore.py:87
msgid "Play indicator sounds (Ready, Finished, Error)"
msgstr "Reproducir sonidos indicadores (Listo, Finalizado, Error)"

#: cmdCore.py:536
msgid "Single tap: toggle line review (Up and Down arrows read the console output one line at a time). Double tap: open the CMDReader log file. Triple tap: open CMDReader settings"
msgstr "Un toque: alternar la revisión de líneas (las flechas Arriba y Abajo leen la salida de la consola línea por línea). Dos toques: abrir el archivo de registro de CMDReader. Tres toques: abrir la configuración de CMDReader"

#: cmdCore.py:97
msgid "Start line review automatically when a console window gets focus"
msgstr "Iniciar la revisión de líneas automáticamente cuando una ventana de consola obtenga el foco"

#: cmdCore.py:82
msgid "Strict Privacy Mode (Disable writing logs to disk)"
msgstr "Modo de privacidad estricta (Desactivar escritura de registros en disco)"


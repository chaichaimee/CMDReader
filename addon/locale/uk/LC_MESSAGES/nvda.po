msgid "Command Finished"
msgstr "Команду виконано"

#: cmdCore.py:613
msgid "Could not open CMDReader log"
msgstr "Не вдалося відкрити журнал CMDReader"

#: cmdCore.py:102
msgid "Error keywords (comma separated):"
msgstr "Ключові слова помилок (через кому):"

#: cmdCore.py:567
msgid "Line review is disabled in settings"
msgstr "Перегляд рядків вимкнено в налаштуваннях"

#: cmdCore.py:571
msgid "Line review off"
msgstr "Перегляд рядків вимкнено"

#: cmdCore.py:577
msgid "Line review on"
msgstr "Перегляд рядків увімкнено"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "Файл журналу не знайдено"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "Ведення журналу вимкнено в суворому режимі конфіденційності"

#: cmdCore.py:493
msgid "No history available"
msgstr "Історія недоступна"

#: cmdCore.py:488
msgid "Not in Command Prompt"
msgstr "Не в командному рядку"

#: cmdCore.py:603
msgid "Opening CMDReader log"
msgstr "Відкриття журналу CMDReader"

#: cmdCore.py:87
msgid "Play indicator sounds (Ready, Finished, Error)"
msgstr "Відтворювати звукові індикатори (Готово, Завершено, Помилка)"

#: cmdCore.py:536
msgid "Single tap: toggle line review (Up and Down arrows read the console output one line at a time). Double tap: open the CMDReader log file. Triple tap: open CMDReader settings"
msgstr "Одинарне натискання: перемикання перегляду рядків (стрілки вгору та вниз читають вивід консолі по одному рядку). Подвійне натискання: відкрити файл журналу CMDReader. Потрійне натискання: відкрити налаштування CMDReader"

#: cmdCore.py:97
msgid "Start line review automatically when a console window gets focus"
msgstr "Автоматично запускати перегляд рядків, коли вікно консолі отримує фокус"

#: cmdCore.py:82
msgid "Strict Privacy Mode (Disable writing logs to disk)"
msgstr "Суворий режим конфіденційності (Вимкнути запис журналів на диск)"

#: cmdCore.py:499
msgid "Top"
msgstr "Початок"
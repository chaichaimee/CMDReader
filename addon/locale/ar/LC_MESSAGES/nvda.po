msgid "Line review is disabled in settings"
msgstr "مراجعة الأسطر معطلة في الإعدادات"

#: cmdCore.py:571
msgid "Line review off"
msgstr "إيقاف مراجعة الأسطر"

#: cmdCore.py:577
msgid "Line review on"
msgstr "تشغيل مراجعة الأسطر"

#: cmdCore.py:606
msgid "Log file not found"
msgstr "لم يتم العثور على ملف السجل"

#: cmdCore.py:587
msgid "Logging is disabled in Strict Privacy Mode"
msgstr "تم تعطيل التسجيل في وضع الخصوصية الصارمة"


#: cmdCore.py:92
msgid "Allow line review with the Up and Down arrow keys (single tap of Control+Alt+L toggles it)"
msgstr "อนุญาตให้ทบทวนบรรทัดด้วยปุ่มลูกศรขึ้นและลง (กด Control+Alt+L หนึ่งครั้งเพื่อสลับสถานะ)"

#: cmdCore.py:502
msgid "Bottom"
msgstr "ด้านล่างสุด"

#: cmdCore.py:76
#: cmdCore.py:116
# keep-identical
msgid "CMDReader"
msgstr "CMDReader"


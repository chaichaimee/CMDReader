#: cmdCore.py:92
msgid "Allow line review with the Up and Down arrow keys (single tap of Control+Alt+L toggles it)"
msgstr "위아래 화살표 키로 줄 단위 검토 허용(Control+Alt+L을 한 번 누르면 전환됨)"

#: cmdCore.py:502
msgid "Bottom"
msgstr "맨 아래"

#: cmdCore.py:76
#: cmdCore.py:116
# keep-identical
msgid "CMDReader"
msgstr "CMDReader"

